<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：一个带转发箭头的对话气泡。

  立体感处理得很克制，只用三样东西：
    1. 同形状、下移 2.5、低透明度的投影 —— 让气泡从背景里浮起来
    2. 气泡本体自上而下的白色到浅灰渐变 —— 上沿受光、下沿背光
    3. 上沿一道极淡的高光 —— 模拟边缘反光

  几何约束：内容全部落在以 (54,54) 为心、半径 33 的安全区内，
  因此无论系统套用圆形、方形还是圆角矩形遮罩都不会被切到。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 投影 -->
    <group android:translateY="2.5">
        <path
            android:pathData="M42,32 Q34,32 34,40 L34,56 Q34,64 42,64 L48,64 L40,74 L54,64 L66,64 Q74,64 74,56 L74,40 Q74,32 66,32 Z"
            android:fillColor="#26000000" />
    </group>

    <!-- 气泡本体 -->
    <path android:pathData="M42,32 Q34,32 34,40 L34,56 Q34,64 42,64 L48,64 L40,74 L54,64 L66,64 Q74,64 74,56 L74,40 Q74,32 66,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="32"
                android:endX="54"
                android:endY="74">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.62" android:color="#FFF6FAFB" />
                <item android:offset="1" android:color="#FFE3ECF0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 上沿高光 -->
    <path
        android:pathData="M44,34.6 Q54,33.4 64,34.6 Q64.6,35.6 64,36.6 Q54,35.4 44,36.6 Q43.4,35.6 44,34.6 Z"
        android:fillColor="#B3FFFFFF" />

    <!-- 转发箭头 -->
    <path
        android:pathData="M46,46.2 L57,46.2 L57,42 L65,48 L57,54 L57,49.8 L46,49.8 Z"
        android:fillColor="#FF0E4D64" />
</vector>
